#!/usr/bin/env bash
# validate.sh — Project validation script for {{ project_name }}
# Generated by cpp-constitution

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m'

PASS=0
FAIL=0

check() {
    local desc="$1"
    local cmd="$2"
    echo -n "  Checking $desc... "
    if eval "$cmd" >/dev/null 2>&1; then
        echo -e "${GREEN}OK${NC}"
        ((PASS++))
    else
        echo -e "${RED}FAIL${NC}"
        ((FAIL++))
    fi
}

echo "🔍 Validating {{ project_name }}"
echo "================================"

# 1. Governance files
echo ""
echo "--- Governance ---"
check "CONSTITUTION.md"        "test -f CONSTITUTION.md"
check "AGENTS.md"              "test -f AGENTS.md"
check ".cpp-constitution/"     "test -d .cpp-constitution"

# 2. C++ rules
echo ""
echo "--- C++ Rules ---"
check ".cpp-constitution/references/" "test -d .cpp-constitution/references"
check ".cpp-constitution/config/"     "test -d .cpp-constitution/config"
check ".cpp-constitution/GOTCHAS.md"  "test -f .cpp-constitution/GOTCHAS.md"
{% if build == "cmake" %}
# 3. Build system
echo ""
echo "--- Build (cmake) ---"
check "CMakeLists.txt"         "test -f CMakeLists.txt"
check "compile_commands.json"  "test -f compile_commands.json || test -f build/compile_commands.json"
{% elif build == "make" %}
echo ""
echo "--- Build (make) ---"
check "Makefile"               "test -f Makefile"
check "compile_commands.json"  "test -f compile_commands.json"
{% elif build == "xmake" %}
echo ""
echo "--- Build (xmake) ---"
check "xmake.lua"              "test -f xmake.lua"
{% elif build == "meson" %}
echo ""
echo "--- Build (meson) ---"
check "meson.build"            "test -f meson.build"
{% elif build == "autotools" %}
echo ""
echo "--- Build (autotools) ---"
check "configure.ac"           "test -f configure.ac"
check "Makefile.am"            "test -f Makefile.am"
{% endif %}

# 4. Source structure
echo ""
echo "--- Source ---"
check "src/"                   "test -d src"

# 5. Python compile check (if scripts exist)
echo ""
echo "--- Scripts ---"
for f in scripts/*.py; do
    [ -f "$f" ] && check "$(basename $f) compiles" "python3 -m py_compile $f"
done

# Summary
echo ""
echo "================================"
if [ $FAIL -eq 0 ]; then
    echo -e "${GREEN}✅ ALL CHECKS PASSED${NC} ($PASS passed)"
    exit 0
else
    echo -e "${RED}❌ $FAIL check(s) failed${NC} ($PASS passed)"
    exit 1
fi
